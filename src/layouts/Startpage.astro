---
import { getCollection, type CollectionEntry } from "astro:content";
import Hero from "../components/Hero.astro";
import PostItem from "../components/PostItem.astro";
import ProjectCard from "../components/ProjectCard.astro";
import TalkCard from "../components/TalkCard.astro";
import WidgetBook from "../components/WidgetBook.astro";
import WidgetNewsletter from "../components/WidgetNewsletter.astro";
import PostRepository from "../lib/domain/article/PostRepository";
import Layout from "./Layout.astro";

const postRepository = new PostRepository();

// Define valid categories and generate static paths
export async function getStaticPaths() {
	const posts = await getCollection("blog");
	const categories = getUniqueCategories(posts);

	categories.add("all");

	return Array.from(categories).map((category) => ({
		params: { category },
		props: { category },
	}));
}

export function getUniqueCategories(
	posts: CollectionEntry<"blog">[],
): Set<string> {
	return posts.reduce((acc: Set<any>, post: any) => {
		if (post.data.category) {
			acc.add(post.data.category);
		}
		return acc;
	}, new Set());
}

const { category } = Astro.props;

const posts = await postRepository.findPosts();

const categories: Set<string> = posts.reduce((acc, post) => {
	acc.add(post.data.category);
	return acc;
}, new Set<string>());

const filteredPosts =
	category !== "all"
		? posts.filter((post) => post.data.category === category)
		: posts;

const counts: Record<string, number> = { all: posts.length };
categories.forEach((currentCategory) => {
	counts[currentCategory] = posts.filter(
		(post) => post.data.category === currentCategory,
	).length;
});

const withMedia = posts.filter((post) => {
	const { spotifyLink, youtubeLink, infographicLink } = post.data;
	return Boolean(spotifyLink || youtubeLink || infographicLink);
}).length;

const fmtLong = (date: Date) =>
	date.toLocaleDateString("en-US", {
		month: "short",
		day: "numeric",
		year: "numeric",
		timeZone: "UTC",
	});

const stats = [
	{ label: "Articles", value: String(posts.length).padStart(2, "0") },
	{ label: "Latest", value: fmtLong(posts[0].data.pubDate) },
	{
		label: "With podcast / video",
		value: String(withMedia).padStart(2, "0"),
	},
	{ label: "Topics", value: "Tech · Leadership" },
];

const tabLabel = (value: string) => value.charAt(0).toUpperCase() + value.slice(1);

const talks = [
	{
		title: "Data Mesh",
		image: "/images/videos/data-mesh.webp",
		href: "https://www.youtube.com/watch?v=_bmYXWCxF_Q",
	},
	{
		title: "Why Leaders Eat Last?",
		image: "/images/videos/why-leaders-eat-last.webp",
		href: "https://www.youtube.com/watch?v=GE1w8OORirA",
	},
];

const projects = [
	{
		title: "Skill Match",
		description: "Finde und buche Experten, Coaches und Trainer basierend auf Skills",
		logo: "/images/logos/skillmatch.svg",
		href: "https://skillmatch.de/",
	},
	{
		title: "DDD Template for GoLang projects",
		description: "Domain Driven Design (DDD) template for Golang to properly organize a project with many useful tools set up.",
		logo: "/images/logos/ddd_template_go_v2.png",
		href: "https://github.com/sesigl/go-project-ddd-template",
	},
];
---

<Layout
	active="home"
	title="Software Engineer who loves frontend, backend, architecture, data and machine-learning."
	description="Writer, Speaker and Developer. I write about coding, startups, and my journey as a full-time software engineer."
>
	<Hero
		avatarSrc="/images/me_sesigl_2.png"
		before="Notes on building software,"
		highlight="systems"
		after="and teams."
		lede="Long-form articles on AI-augmented engineering, search, and technical leadership. Some come with a podcast, video or infographic."
		stats={stats}
	/>

	<div class="ss-page ss-page--home">
		<div class="ss-page__col">
			<section aria-labelledby="latest">
				<h2 id="latest" class="ss-sr-only">Articles</h2>
				<div class="ss-toolbar">
					<ul class="ss-tabs" aria-label="Filter articles by topic">
						<li>
							<a
								class="ss-tab"
								href="/"
								aria-current={category === "all" ? "page" : undefined}
								>All<span class="ss-tab__count" aria-label={`(${counts.all} articles)`}
									>{counts.all}</span
								></a
							>
						</li>
						{
							Array.from(categories).map((currentCategory) => (
								<li>
									<a
										class="ss-tab"
										href={`/${currentCategory}`}
										aria-current={category === currentCategory
											? "page"
											: undefined}
									>
										{tabLabel(currentCategory)}
										<span class="ss-tab__count" aria-label={`(${counts[currentCategory]} articles)`}>
											{counts[currentCategory]}
										</span>
									</a>
								</li>
							))
						}
					</ul>
					<span class="ss-toolbar__end" aria-live="polite">
						{filteredPosts.length}
						{filteredPosts.length === 1 ? " article" : " articles"}
					</span>
				</div>
				<ol class="ss-post-list">
					{
						filteredPosts.map((post) => (
							<li>
								<PostItem
									title={post.data.title}
									description={post.data.description}
									date={post.data.pubDate}
									readingTime={post.data.readingTimeInMinutes ?? 10}
									href={post.data.link ?? `/blog/${post.data.slug}`}
									category={post.data.link ? undefined : post.data.category}
									media={
										post.data.link
											? undefined
											: {
													spotify: post.data.spotifyLink,
													youtube: post.data.youtubeLink,
													infographic: post.data.infographicLink,
												}
									}
									index={posts.length - posts.indexOf(post)}
									showTags={true}
								/>
							</li>
						))
					}
				</ol>
			</section>

			<section class="ss-section" aria-labelledby="talks">
				<div class="ss-section-head">
					<span class="ss-section-head__n">02</span>
					<h2 id="talks" class="ss-section-title">Talks</h2>
					<span class="ss-section-head__end">Video</span>
				</div>
				<div class="ss-grid-2">
					{talks.map((talk) => <TalkCard {...talk} />)}
				</div>
			</section>

			<section class="ss-section" aria-labelledby="projects">
				<div class="ss-section-head">
					<span class="ss-section-head__n">03</span>
					<h2 id="projects" class="ss-section-title">Projects</h2>
					<span class="ss-section-head__end">Open source · Products</span>
				</div>
				<div class="ss-grid-2">
					{projects.map((project) => <ProjectCard {...project} />)}
				</div>
			</section>
		</div>

		<aside class="ss-page__aside" aria-label="Sidebar">
			<div class="ss-page__sticky">
				<WidgetNewsletter />
				<WidgetBook />
			</div>
		</aside>
	</div>
</Layout>
