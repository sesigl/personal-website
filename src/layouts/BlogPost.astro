---
import { render, type CollectionEntry } from "astro:content";
import ArticleHeader from "../components/ArticleHeader.astro";
import BackButton from "../components/BackButton.astro";
import ReadingProgress from "../components/ReadingProgress.astro";
import ShareButtons from "../components/ShareButtons.astro";
import SubscribeForm from "../components/SubscribeForm.astro";
import TableOfContents from "../components/TableOfContents.astro";
import Tag from "../components/Tag.astro";
import WidgetNewsletter from "../components/WidgetNewsletter.astro";
import WidgetPosts from "../components/WidgetPosts.astro";
import { BASE_URL } from "../consts";
import PostRepository from "../lib/domain/article/PostRepository";
import Layout from "./Layout.astro";

type Props = CollectionEntry<"blog">;

const { data, id } = Astro.props;

let canonicalLink: string | null = null;
if (data.slugAlternative === id) {
	canonicalLink = `/posts/${data.slug}`;
}

const { Content, headings } = await render({
	...Astro.props,
	id: id,
	collection: "blog",
	data: data,
});

// Articles whose sections are marked up as h3 (or that only carry the generated
// "Footnotes" h2) still get a useful table of contents: fall back to h3.
const h2Headings = headings.filter((heading) => heading.depth === 2);
const tocHeadings =
	h2Headings.length > 1
		? h2Headings
		: headings.filter(
				(heading) => heading.depth === 3 || heading.slug === "footnote-label",
			);

const toc = tocHeadings.map((heading) => ({ id: heading.slug, label: heading.text }));

const readingTime = data.readingTimeInMinutes ?? 10;
const postUrl = `${BASE_URL}/posts/${data.slug}`;

// "Next article" walks the internal archive only, newest to oldest, and wraps.
const allPosts = await new PostRepository().findPosts();
const internalPosts = allPosts.filter((post) => !post.data.link);
const currentIndex = internalPosts.findIndex((post) => post.id === id);
const nextPost =
	internalPosts.length > 1 && currentIndex !== -1
		? internalPosts[(currentIndex + 1) % internalPosts.length]
		: undefined;
---

<Layout
	active="home"
	title={data.title}
	description={data.description}
	previewImage={data.heroImage}
	canonicalLink={canonicalLink}
>
	<ReadingProgress targetId="article" />
	<div class="ss-page">
		<div class="ss-page__col">
			<div style="margin-bottom:24px"><BackButton /></div>
			<div class="ss-article">
				<aside class="ss-article__toc">
					<TableOfContents items={toc} />
				</aside>
				<article id="article" class="ss-article__body">
					<ArticleHeader
						title={data.title}
						description={data.description}
						date={data.pubDate}
						readingTime={readingTime}
						category={data.category}
						url={postUrl}
						spotify={data.spotifyLink}
						youtube={data.youtubeLink}
						infographic={data.infographicLink}
					/>
					<div class="ss-prose">
						<Content />
					</div>
					<footer class="ss-article-foot">
						<div
							class="ss-row"
							style="justify-content:space-between;padding-top:20px;border-top:1px solid var(--border-default)"
						>
							<div class="ss-row" style="gap:6px">
								<span class="ss-kicker">Filed under</span>
								<Tag href={`/${data.category}`}>{data.category}</Tag>
							</div>
							<ShareButtons url={postUrl} title={data.title} />
						</div>
						{
							nextPost ? (
								<a class="ss-next" href={nextPost.data.link ?? `/blog/${nextPost.data.slug}`}>
									<span class="ss-kicker">Next article →</span>
									<span class="ss-next__title">{nextPost.data.title}</span>
									<span class="ss-muted" style="font-size:var(--fs-sm)">
										{nextPost.data.readingTimeInMinutes ?? 10} min read
									</span>
								</a>
							) : null
						}
						<section
							class="ss-card"
							aria-labelledby="end-nl"
							style="display:flex;flex-direction:column;gap:12px"
						>
							<div class="ss-kicker">Newsletter</div>
							<h2 id="end-nl" class="ss-h4">Get the next article by email.</h2>
							<SubscribeForm
								id="article-signup-form"
								layout="inline"
								placeholder="you@company.com"
							/>
						</section>
					</footer>
				</article>
			</div>
		</div>
		<aside class="ss-page__aside" aria-label="Sidebar">
			<div class="ss-page__sticky">
				<WidgetNewsletter />
				<WidgetPosts excludedPostIds={[id]} />
			</div>
		</aside>
	</div>
</Layout>
