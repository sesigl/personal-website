---
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import SideNav from "../components/SideNav.astro";
import TopBar from "../components/TopBar.astro";

type Props = {
	active?: "home" | "about" | "subscribe" | "search";
	title: string;
	description: string;
	previewImage?: string;
	canonicalLink?: string | null;
	searchQuery?: string;
};

const { title, description, active, previewImage, canonicalLink, searchQuery } =
	Astro.props;

const finalTitle = `${title} | Sebastian Sigl`;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={finalTitle}
			description={description}
			image={previewImage}
			canonicalLink={canonicalLink}
		/>
		<script is:inline>
			(function () {
				var stored = localStorage.getItem("dark-mode");
				var dark =
					stored === null
						? window.matchMedia("(prefers-color-scheme: dark)").matches
						: stored === "true";
				document.documentElement.setAttribute(
					"data-theme",
					dark ? "dark" : "light",
				);
				document.documentElement.classList.toggle("dark", dark);
			})();
		</script>
	</head>

	<body>
		<a class="ss-skip-link" href="#main">Skip to content</a>
		<div class="ss-shell">
			<TopBar active={active} query={searchQuery} />
			<main id="main" tabindex="-1" class="ss-main">
				<div class="ss-main__inner">
					<slot />
				</div>
			</main>
			<Footer />
			<SideNav active={active} />
		</div>

		<script>
			// Theme toggle + state sync (the theme itself is set before paint in <head>).
			const icons = () => {
				const dark =
					document.documentElement.getAttribute("data-theme") === "dark";
				document
					.querySelectorAll("[data-theme-toggle]")
					.forEach((button) =>
						button.setAttribute("aria-pressed", String(dark)),
					);
			};
			icons();

			document.querySelectorAll("[data-theme-toggle]").forEach((button) => {
				button.addEventListener("click", () => {
					const dark =
						document.documentElement.getAttribute("data-theme") === "dark";
					const next = dark ? "light" : "dark";
					document.documentElement.setAttribute("data-theme", next);
					document.documentElement.classList.toggle("dark", next === "dark");
					localStorage.setItem("dark-mode", String(next === "dark"));
					icons();
				});
			});

			// ⌘K / Ctrl+K focuses the top bar search.
			window.addEventListener("keydown", (event) => {
				if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === "k") {
					const input = document.getElementById("search");
					if (input) {
						event.preventDefault();
						input.focus();
						input.select();
					}
				}
			});
		</script>
	</body>
</html>
