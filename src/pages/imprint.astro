---
import Layout from "../layouts/Layout.astro";

const seoMetaDescription =
	"Imprint of sebastiansigl.com — the responsible person within the meaning of § 5 of the Telemedia Act (TMG).";
---

<Layout active={undefined} title="Imprint" description={seoMetaDescription}>
	<div class="ss-page ss-page--single">
		<div class="ss-page__col">
			<section class="ss-stack-6 ss-page__narrow">
				<div class="ss-kicker">Legal · Published 3.3.2023</div>
				<h1 class="ss-h1">Imprint</h1>
				<p class="ss-muted">
					The responsible person/entity within the meaning of § 5 of the Telemedia
					Act (Telemediengesetz, TMG) for the webpage sebastiansigl.com is:
				</p>
				<address
					class="ss-card"
					style="font-style:normal;font-family:var(--font-mono);font-size:var(--fs-sm);line-height:1.8"
				>
					Sebastian Sigl<br />Roquettestr. 34<br />01157 Dresden<br />support [at]
					sebastiansigl.com
				</address>
			</section>
		</div>
	</div>
</Layout>
