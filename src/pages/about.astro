---
import ExperienceTimeline from "../components/ExperienceTimeline.astro";
import WidgetNewsletter from "../components/WidgetNewsletter.astro";
import Layout from "../layouts/Layout.astro";

const seoMetaDescriptionForAbout =
	"Sebastian Sigl is a Staff Engineer at Adevinta, working on search relevance for Kleinanzeigen, Germany's largest marketplace. He has 18+ years of experience building high-load systems, data- and machine-learning-driven products, and cloud-native platforms.";

const experience = [
	{
		start: "May 2026",
		end: "Present",
		role: "Staff Engineer (MTS 2) | Search Specialist, Core Ad Search",
		org: "Kleinanzeigen (Adevinta)",
		logo: "/images/logos/kleinanzeigen.png",
		logoFill: true,
		description:
			"I work on Kleinanzeigen Search, the search behind Germany's largest marketplace. My focus is search relevance. I lead the migration from Elasticsearch to Vespa, from relevance and architecture through to production. I also drive AI-assisted development: I build the tooling and run the training that help our engineers ship faster.",
	},
	{
		start: "Dec 2022",
		end: "May 2026",
		role: "Staff Engineer (MTS 2) | Architect, Advertising",
		org: "Kleinanzeigen (Adevinta)",
		logo: "/images/logos/kleinanzeigen.png",
		logoFill: true,
		description:
			"I designed an in-house retail media platform for first-party ads and led multiple teams from domain design to production: feed ingestion of large advertiser catalogs, ad retrieval on Elasticsearch on Kubernetes, and integration with an external auction and budget-pacing service. I built the A/B testing setup for first-party ads and co-ran AI workshops for around 30 engineers, which later scaled to the whole Kleinanzeigen engineering organization.",
	},
	{
		start: "Oct 2018",
		end: "Dec 2022",
		role: "Classifieds Senior Full-Stack Engineer | Tech Lead Advertising",
		org: "eBay",
		logo: "/images/logos/ebay.png",
		description:
			"First as Senior Full-Stack Engineer, later as Tech Lead for advertising, I led the team that built a global advertising configuration system. Yield experts used it every day to manage campaigns and optimize revenue.",
	},
	{
		start: "Oct 2016",
		end: "Sep 2018",
		role: "Senior Full-Stack Engineer",
		org: "MisterSpex",
		logo: "/images/logos/mister-spex.png",
		description:
			"I led the team that built an augmented reality try-on, so customers could try on glasses virtually. It was a key part of the move from a mostly brick-and-mortar retailer to a digital-first business.",
	},
	{
		start: "Oct 2014",
		end: "Sep 2016",
		role: "Mid-Level Backend Engineer",
		org: "Sopra Steria",
		logo: "/images/logos/sopra-steria.png",
		description:
			"I modernized a legacy Java Swing application and split frontend and backend out of a large monolith. Backend performance and the user experience both improved. I also introduced a test-first approach, so the extracted components were easier to change and had fewer defects.",
	},
	{
		start: "Oct 2005",
		end: "Sep 2014",
		role: "High School, Computer Science Master & Freelancer",
		org: "Self-Employed",
		logo: "/images/logos/freelance.png",
		description:
			"I started coding as a teenager. At 17, I built a social network for the Turkish market, my first real product. After that, I did contract work for different companies while I finished high school and my Master's in Computer Science.",
	},
];
---

<Layout active="about" title="About" description={seoMetaDescriptionForAbout}>
	<div class="ss-page">
		<div class="ss-page__col">
			<div class="ss-stack-10">
				<section class="ss-stack-6">
					<div class="ss-kicker">About</div>
					<h1 class="ss-display">
						Hi. I'm Sebastian <span class="ss-hl">@sesigl</span> Sigl.
					</h1>
					<p class="ss-lede" style="max-width:60ch">
						Staff Engineer at Adevinta, working on search and relevance for
						Kleinanzeigen, Germany's largest marketplace. 18+ years building
						high-load systems, data products and platforms.
					</p>
					<img
						src="/images/about_v3.png"
						alt="Sebastian Sigl speaking on stage"
						style="width:100%;border-radius:4px;border:1px solid var(--border-default)"
					/>
				</section>

				<section aria-labelledby="bio" class="ss-stack-4">
					<div class="ss-section-head">
						<span class="ss-section-head__n">01</span>
						<h2 id="bio" class="ss-section-title">Short Bio</h2>
					</div>
					<div class="ss-muted ss-stack-4" style="max-width:68ch">
						<p>
							I am a software engineer with 18+ years of experience. I like
							problems where scale matters: search platforms, high-load
							server-side systems, and data- and machine-learning-driven
							products. I enjoy working close to the infrastructure, with
							containers and cloud-native technologies. Lately, a lot of my time
							goes into how AI changes the way we build software.
						</p>
						<p>
							I write and speak about search, platform engineering, and
							AI-assisted development. This site collects what I build and what I
							learn along the way.
						</p>
					</div>
				</section>

				<section aria-labelledby="career" class="ss-stack-4">
					<div class="ss-section-head">
						<span class="ss-section-head__n">02</span>
						<h2 id="career" class="ss-section-title">Career</h2>
					</div>
					<div class="ss-muted ss-stack-4" style="max-width:68ch">
						<p>
							At Adevinta, I work on search for{" "}
							<a href="https://www.kleinanzeigen.de/" target="_blank" rel="noopener noreferrer"
								>Kleinanzeigen</a
							>, Germany's largest marketplace. My focus is search relevance. I
							lead the migration from Elasticsearch to Vespa together with
							multiple teams, from relevance and architecture through to
							production.
						</p>
						<p>
							I joined Core Ad Search in May 2026. Before that, I led multiple
							teams in advertising and built a greenfield retail media system for
							first-party ads. In both roles,
							I also work on making AI a practical part of how our engineers
							build software.
						</p>
						<p>
							Kleinanzeigen is part of{" "}
							<a href="https://www.adevinta.com" target="_blank" rel="noopener noreferrer"
								>Adevinta</a
							>, a group of classifieds marketplaces across Europe.
						</p>
						<p>
							I believe anyone with a passion for technology can learn to code.
							That is why I create <a
								href="https://x.com/sesigl"
								target="_blank"
								rel="noopener noreferrer">content</a
							>: I write, give talks, and mentor engineers earlier in their
							careers. It also keeps me sharp and connected to the wider
							engineering community.
						</p>
					</div>
				</section>

				<section aria-labelledby="exp">
					<div class="ss-section-head">
						<span class="ss-section-head__n">03</span>
						<h2 id="exp" class="ss-section-title">Experience</h2>
						<span class="ss-section-head__end">{experience.length} roles</span>
					</div>
					<ExperienceTimeline items={experience} />
				</section>

				<section aria-labelledby="connect" class="ss-stack-4">
					<div class="ss-section-head">
						<span class="ss-section-head__n">04</span>
						<h2 id="connect" class="ss-section-title">Let's Connect</h2>
					</div>
					<p class="ss-muted" style="max-width:68ch">
						I am happy to talk about search, platforms, AI-assisted development, or new roles. Reach me by <a
							href="mailto:support@sebastiansigl.com">email</a
						> or on <a href="https://x.com/sesigl" target="_blank" rel="noopener noreferrer"
							>X</a
						>. I am not taking on freelance work right now, but I am always open
						to the right conversation.
					</p>
				</section>
			</div>
		</div>
		<aside class="ss-page__aside" aria-label="Sidebar">
			<div class="ss-page__sticky">
				<WidgetNewsletter />
			</div>
		</aside>
	</div>
</Layout>
