---
import ExperienceTimeline from "../components/ExperienceTimeline.astro";
import WidgetNewsletter from "../components/WidgetNewsletter.astro";
import Layout from "../layouts/Layout.astro";

const seoMetaDescriptionForAbout =
	"Sebastian Sigl is a Staff Engineer at Adevinta, working on search and relevance for Kleinanzeigen. With over 18 years of experience, he builds high-load systems, data- and machine-learning-driven applications, and platforms, and loves tinkering with infrastructure, containers, and Cloud Native technologies.";

const experience = [
	{
		start: "Dec 2022",
		end: "Present",
		role: "Staff Engineer (MTS 2)",
		org: "Adevinta",
		logo: "/images/logos/adevinta.png",
		description:
			"As a Staff Engineer at Adevinta, I work on Kleinanzeigen Search, the search behind Germany's largest marketplace. My focus is entirely on search relevance, and I lead the migration from Elasticsearch to Vespa, from relevance and architecture through to production. Before that, I led multiple teams in advertising, where I built a greenfield retail media system for first-party advertising on Elasticsearch. I also drive our AI-assisted development efforts, building the tooling and training that help engineers move faster, and I serve on our architecture board.",
	},
	{
		start: "Oct 2018",
		end: "Dec 2022",
		role: "Classifieds Senior Full-Stack Engineer | Tech Lead Advertising",
		org: "eBay",
		logo: "/images/logos/ebay.png",
		description:
			"As a senior Full-Stack Engineer and later tech lead for advertising, I led a team that built a global advertising configuration system. It was the tool yield experts used to manage campaigns and optimize revenue, with the flexibility and control they needed.",
	},
	{
		start: "Oct 2016",
		end: "Sep 2018",
		role: "Senior Full-Stack Engineer",
		org: "MisterSpex",
		logo: "/images/logos/mister-spex.png",
		description:
			"As a Senior Full-Stack Engineer, I led a team that built an augmented reality try-on so customers could virtually try on glasses. It helped turn a mostly brick-and-mortar retailer into a digital-first business.",
	},
	{
		start: "Oct 2014",
		end: "Sep 2016",
		role: "Mid-Level Backend Engineer",
		org: "Sopra Steria",
		logo: "/images/logos/sopra-steria.png",
		description:
			"I modernized a legacy Java Swing application, splitting the frontend and backend out of a large monolith. Backend performance and the frontend experience both improved, and I drove a test-first approach so the extracted components were easier to change and caused fewer defects.",
	},
	{
		start: "Oct 2005",
		end: "Sep 2014",
		role: "High School, Computer Science Master & Freelancer",
		org: "Self-Employed",
		logo: "/images/logos/freelance.png",
		description:
			"From my teenage years onwards, coding has been my passion. At 17 I built a social network for the Turkish market, which marked the start of my journey as a developer. Since then I have kept honing my skills with contract work for various companies, all while pursuing my education.",
	},
];
---

<Layout active="about" title="About" description={seoMetaDescriptionForAbout}>
	<div class="ss-page">
		<div class="ss-page__col">
			<div class="ss-stack-10">
				<section class="ss-stack-6">
					<div class="ss-kicker">About</div>
					<h1 class="ss-display">
						Hi. I'm Sebastian <span class="ss-hl">@sesigl</span> Sigl.
					</h1>
					<p class="ss-lede" style="max-width:60ch">
						Staff Engineer at Adevinta, working on search and relevance for
						Kleinanzeigen, Germany's largest marketplace. 18+ years building
						high-load systems, data products and platforms.
					</p>
					<img
						src="/images/about_v3.png"
						alt="Sebastian Sigl speaking on stage"
						style="width:100%;border-radius:4px;border:1px solid var(--border-default)"
					/>
				</section>

				<section aria-labelledby="bio" class="ss-stack-4">
					<div class="ss-section-head">
						<span class="ss-section-head__n">01</span>
						<h2 id="bio" class="ss-section-title">Short Bio</h2>
					</div>
					<div class="ss-muted ss-stack-4" style="max-width:68ch">
						<p>
							I am a software engineer with over 18 years of experience across
							various domains. In recent years my focus has been on search
							platforms, high-load server-side projects, and data- and
							machine-learning-driven applications. I love tinkering with
							infrastructure, containers, and Cloud Native technologies, and
							lately I spend a lot of my time on how AI changes the way we build
							software.
						</p>
						<p>
							I write and speak about search, platform engineering, and
							AI-assisted development. This site collects what I build and what I
							learn along the way.
						</p>
					</div>
				</section>

				<section aria-labelledby="career" class="ss-stack-4">
					<div class="ss-section-head">
						<span class="ss-section-head__n">02</span>
						<h2 id="career" class="ss-section-title">Career</h2>
					</div>
					<div class="ss-muted ss-stack-4" style="max-width:68ch">
						<p>
							As a Staff Engineer at Adevinta, I work on Kleinanzeigen Search,
							where my focus is entirely on search relevance. I lead its migration
							from Elasticsearch to Vespa together with multiple teams across{" "}
							<a href="https://www.kleinanzeigen.de/" target="_blank" rel="noopener noreferrer"
								>Kleinanzeigen</a
							>
							, one of the largest classifieds marketplaces in the world.
						</p>
						<p>
							Before that, I led multiple teams in advertising, where I built a
							greenfield retail media system for first-party advertising on
							Elasticsearch. I also spend a lot of time on AI, making it a
							practical part of how our engineers build software.
						</p>
						<p>
							Kleinanzeigen is part of{" "}
							<a href="https://www.adevinta.com" target="_blank" rel="noopener noreferrer"
								>Adevinta</a
							>, which brings several classifieds businesses together. That scale
							is part of why the search work here is interesting.
						</p>
						<p>
							Technology is my driving force, and I believe anyone with a passion
							for it can learn to code. That is why I create <a
								href="https://x.com/sesigl"
								target="_blank"
								rel="noopener noreferrer">content</a
							>: writing, talks, and mentoring for people earlier in their careers.
							It keeps me sharp and connects me to the wider engineering community.
						</p>
					</div>
				</section>

				<section aria-labelledby="exp">
					<div class="ss-section-head">
						<span class="ss-section-head__n">03</span>
						<h2 id="exp" class="ss-section-title">Experience</h2>
						<span class="ss-section-head__end">{experience.length} roles</span>
					</div>
					<ExperienceTimeline items={experience} />
				</section>

				<section aria-labelledby="connect" class="ss-stack-4">
					<div class="ss-section-head">
						<span class="ss-section-head__n">04</span>
						<h2 id="connect" class="ss-section-title">Let's Connect</h2>
					</div>
					<p class="ss-muted" style="max-width:68ch">
						I am happy to talk about projects, ideas, or roles. Reach me by <a
							href="mailto:support@sebastiansigl.com">email</a
						> or on <a href="https://x.com/sesigl" target="_blank" rel="noopener noreferrer"
							>X</a
						>. I am not taking on freelance work right now, but I am always open
						to the right conversation.
					</p>
				</section>
			</div>
		</div>
		<aside class="ss-page__aside" aria-label="Sidebar">
			<div class="ss-page__sticky">
				<WidgetNewsletter />
			</div>
		</aside>
	</div>
</Layout>
