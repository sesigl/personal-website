---
import BackButton from "../components/BackButton.astro";
import Icon from "../components/Icon.astro";
import PostItem from "../components/PostItem.astro";
import WidgetBook from "../components/WidgetBook.astro";
import Layout from "../layouts/Layout.astro";
import PostRepository, { type Post } from "../lib/domain/article/PostRepository";

export const prerender = false;

const postRepository = new PostRepository();

const params = Astro.url.searchParams;
const searchQuery = params.get("q")?.trim() ?? "";

const isCategoryOnly = params.get("categoryOnly") !== null;
let searchResultPosts: Post[] = [];

if (searchQuery) {
	searchResultPosts = await postRepository.findPostByQuery(
		searchQuery,
		isCategoryOnly,
	);
}

const seoMetaTitle = searchQuery
	? isCategoryOnly
		? `Articles in “${searchQuery}”`
		: `Search results for “${searchQuery}”`
	: "Search the archive";
const seoMetaDescription = `Find the most relevant blog posts and resources covering “${searchQuery}” on sebastiansigl.com.`;
---

<Layout
	active="search"
	title={seoMetaTitle}
	description={seoMetaDescription}
	searchQuery={isCategoryOnly ? "" : searchQuery}
>
	<div class="ss-page">
		<div class="ss-page__col">
			<div class="ss-stack-6">
				<div><BackButton /></div>
				<div class="ss-stack-4">
					<div class="ss-kicker">{isCategoryOnly ? "Topic" : "Search"}</div>
					<h1 class="ss-h1" aria-live="polite">
						{
							searchQuery
								? isCategoryOnly
									? <>Articles in “{searchQuery}”</>
									: <>Results for “{searchQuery}”</>
								: "Search the archive"
						}
					</h1>
					<form
						role="search"
						method="get"
						action="/search"
						style="display:flex;gap:8px;max-width:560px"
					>
						<div style="flex:1">
							<label class="ss-sr-only" for="search-page">Search articles</label>
							<div class="ss-input-wrap">
								<span class="ss-input-wrap__icon"><Icon name="search" size={14} /></span>
								<input
									id="search-page"
									class="ss-input ss-input--lg"
									type="search"
									name="q"
									placeholder="Try “search”, “AI” or “leadership”"
									value={searchQuery}
								/>
							</div>
						</div>
						<button class="ss-btn ss-btn--primary ss-btn--lg" type="submit">Search</button>
					</form>
				</div>
				<div>
					{
						searchQuery ? (
							<div class="ss-toolbar">
								<span class="ss-kicker">
									{searchResultPosts.length}
									{searchResultPosts.length === 1 ? " article" : " articles"}
								</span>
							</div>
						) : null
					}
					{
						searchResultPosts.length ? (
							<ol class="ss-post-list">
								{searchResultPosts.map((post) => (
									<li>
										<PostItem
											title={post.data.title}
											description={post.data.description}
											date={post.data.pubDate}
											readingTime={post.data.readingTimeInMinutes ?? 10}
											href={post.data.link ?? `/blog/${post.data.slug}`}
											category={post.data.category}
											showTags={true}
											headingLevel={2}
										/>
									</li>
								))}
							</ol>
						) : searchQuery ? (
							<div class="ss-empty">
								<p class="ss-h4">No articles match “{searchQuery}”.</p>
								<p>
									Try a broader term, or browse <a href="/tech">Tech</a> and{" "}
									<a href="/leadership">Leadership</a>.
								</p>
							</div>
						) : null
					}
				</div>
			</div>
		</div>
		<aside class="ss-page__aside" aria-label="Sidebar">
			<div class="ss-page__sticky">
				<WidgetBook />
			</div>
		</aside>
	</div>
</Layout>
