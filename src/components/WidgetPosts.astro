---
import PostRepository from "../lib/domain/article/PostRepository";

interface Props {
	excludedPostIds?: string[];
	title?: string;
}

const { excludedPostIds = [], title = 'Popular' } = Astro.props;

const allPosts = await new PostRepository().findPosts();
const posts = allPosts
	.filter((post) => !excludedPostIds.includes(post.id))
	.slice(0, 4);
---

<section class="ss-widget" aria-labelledby="popular-posts">
	<h2 id="popular-posts" class="ss-kicker">{title}</h2>
	<ol class="ss-widget__list">
		{
			posts.map((post) => (
				<li>
					<a href={post.data.link ?? `/blog/${post.data.slug}`}>{post.data.title}</a>
				</li>
			))
		}
	</ol>
</section>
