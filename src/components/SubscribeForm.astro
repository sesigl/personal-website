---
interface Props {
	id?: string;
	layout?: 'stacked' | 'inline';
	placeholder?: string;
	buttonLabel?: string;
	testIds?: boolean;
	class?: string;
}

const {
	id,
	layout = 'stacked',
	placeholder = 'Your email…',
	buttonLabel = 'Subscribe',
	testIds = false,
	class: className,
} = Astro.props;

// Unique, deterministic id per rendered form (a page can hold more than one form).
const uid = id ?? `newsletter-form-${Math.random().toString(36).slice(2, 8)}`;
const emailId = `${uid}-email`;

const inline = layout === 'inline';
const buttonCls = inline ? 'ss-btn ss-btn--primary' : 'ss-btn ss-btn--primary ss-btn--sm ss-btn--block';
---

<div class:list={['js-newsletter-root', 'ss-subscribe', inline && 'ss-subscribe--inline', className]}>
	<form id={uid} class="ss-subscribe__form">
		<div class="ss-subscribe__field">
			<label class="ss-sr-only" for={emailId}>Your email</label>
			<input
				id={emailId}
				class="ss-input js-newsletter-email-input"
				type="email"
				name="email"
				autocomplete="email"
				placeholder={placeholder}
				required
				data-testid={testIds ? 'subscribe-form-input' : undefined}
			/>
		</div>
		<button
			class={buttonCls}
			type="submit"
			data-testid={testIds ? 'subscribe-form-button' : undefined}
		>
			{buttonLabel}
		</button>
	</form>
	<div
		class="ss-subscribe-note js-newsletter-status"
		role="status"
		tabindex="-1"
		hidden
	>
		<span class="ss-subscribe-note__mark" aria-hidden="true"></span>
		<div class="ss-subscribe-note__copy">
			<p class="ss-subscribe-note__title js-newsletter-status-title">Thanks for subscribing.</p>
			<p class="ss-subscribe-note__text js-newsletter-status-text">
				You're on the list. New articles land in your inbox.
			</p>
		</div>
	</div>
</div>

<script>
	import { setupNewsletterForm } from "../lib/infrastructure/inlineJs/setupNewsletterForm";

	document.querySelectorAll<HTMLElement>(".js-newsletter-root").forEach((root) => {
		setupNewsletterForm(root);
	});
</script>
