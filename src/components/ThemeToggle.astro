---
import Icon from './Icon.astro';
---

<button type="button" class="ss-icon-btn" data-theme-toggle aria-pressed="false" aria-label="Toggle dark mode">
	<Icon name="sun" class="js-theme-icon-light" />
	<Icon name="moon" class="js-theme-icon-dark" />
	<span class="ss-sr-only">Switch light / dark</span>
</button>
