---
import SubscribeForm from "./SubscribeForm.astro";

interface Props {
	avatars?: string[];
	kicker?: string;
	title?: string;
	subtitle?: string;
	proof?: string;
	id?: string;
}

const {
	avatars = [
		'/images/avatar-01.jpg',
		'/images/avatar-02.jpg',
		'/images/avatar-03.jpg',
		'/images/avatar-04.jpg',
	],
	kicker = 'Newsletter',
	title = 'Big tech from the inside.',
	subtitle = 'New articles on engineering and leadership, straight to your inbox. No spam, unsubscribe anytime.',
	proof = 'Join 100K+ developers',
	id = 'newsletter-widget',
} = Astro.props;
---

<section class="ss-card" aria-labelledby={`${id}-title`}>
	<div class="ss-widget">
		<div class="ss-kicker">{kicker}</div>
		<h2 id={`${id}-title`} class="ss-widget__title">{title}</h2>
		<p class="ss-widget__text">{subtitle}</p>
		<SubscribeForm id={`${id}-form`} />
		{
			avatars.length ? (
				<div class="ss-widget__foot">
					<div class="ss-avatars" role="img" aria-label="Newsletter readers">
						{avatars.slice(0, 4).map((src) => <img src={src} width="24" height="24" alt="" />)}
					</div>
					{proof}
				</div>
			) : null
		}
	</div>
</section>
