---
interface Props {
	title?: string;
	text?: string;
	cover?: string;
	href?: string;
}

const {
	title = 'Free Notion Templates',
	text = 'The templates I use to plan work, write and run 1:1s.',
	cover = '/images/book-2.png',
	href = 'https://sesigl.gumroad.com/',
} = Astro.props;
---

<section class="ss-card">
	<a class="ss-widget__book" href={href} target="_blank" rel="noopener noreferrer">
		{cover ? <img class="ss-widget__cover" src={cover} width="72" height="92" alt="" /> : <span></span>}
		<span class="ss-widget">
			<span class="ss-kicker">Free · Gumroad ↗</span>
			<span class="ss-widget__title" style="font-size:var(--fs-base)">{title}</span>
			{text ? <span class="ss-widget__text">{text}</span> : null}
		</span>
		<span class="ss-sr-only">(opens Gumroad in a new tab)</span>
	</a>
</section>
